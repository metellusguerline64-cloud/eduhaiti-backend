# EduHaïti Edge — one configuration per physical school/site
EDU_EDGE_SITE_ID=MT1967
EDU_EDGE_ID=EDGE-MT1967-01
EDU_EDGE_CLOUD_URL=https://mt1967.eduflow.win/api
EDU_EDGE_HOST=0.0.0.0
EDU_EDGE_PORT=8787
EDU_EDGE_DATA_DIR=./.eduhaiti-edge
EDU_EDGE_RETRY_MS=15000
EDU_EDGE_MAX_RETRIES=1000
EDU_EDGE_PROVISIONING_ENABLED=true
# Optional: protected code used only during local terminal provisioning; never put it in frontend code.
EDU_EDGE_PROVISION_CODE=change-this-on-the-edge
# Production hardening
EDU_EDGE_REQUIRE_HTTPS=true
EDU_EDGE_TLS_CERT_FILE=./certs/edge.crt
EDU_EDGE_TLS_KEY_FILE=./certs/edge.key
EDU_EDGE_ALLOWED_ORIGINS=https://ecole.example
EDU_EDGE_REQUIRE_REGISTERED_DEVICE=true
